# Base URL of the existing Node/Express CRM backend (src/backend/server.js).
# Local dev example (matches PORT in the CRM's own .env):
CRM_BASE_URL=http://localhost:5000

# Optional. The existing CRM currently has NO auth middleware on its
# /api/* routes (confirmed in the Day 1 analysis), so this can stay
# empty. It exists so a token can be turned on later without code changes.
CRM_API_TOKEN=

# How long (seconds) to wait for the CRM before treating it as timed out.
CRM_REQUEST_TIMEOUT_SECONDS=10

# --- Gemini API (added Day 3) ---
# Get a key from https://aistudio.google.com/apikey - never commit this.
GEMINI_API_KEY=

# Current GA Flash model as of this writing. Change here (no code
# changes needed) if your team standardizes on a different model.
GEMINI_MODEL=gemini-3.6-flash

# How long (seconds) to wait for Gemini before treating it as timed out.
GEMINI_REQUEST_TIMEOUT_SECONDS=20
